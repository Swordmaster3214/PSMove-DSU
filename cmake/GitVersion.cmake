# Run at build time (cmake -P) so the version tracks the checkout instead of
# going stale until the next reconfigure. Rewrites OUTPUT only when the version
# string changes, so an unchanged version does not trigger a recompile.
#
# Inputs: SOURCE_DIR, OUTPUT, GIT_EXECUTABLE (may be empty)
set(version "dev")
if(GIT_EXECUTABLE)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} describe --tags --always --dirty
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE described
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
    if(described)
        set(version "${described}")
    endif()
endif()

set(content "// Generated by cmake/GitVersion.cmake at build time. Do not edit.\n#pragma once\n#define DSU_VERSION \"${version}\"\n")
set(existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing)
endif()
if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
